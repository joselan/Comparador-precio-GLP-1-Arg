rules_version = '2';

// Reglas de seguridad de Firestore para el Comparador GLP-1.
//
// La app ya no tiene panel de administrador ni login: los precios se gestionan
// únicamente desde el scraper (GitHub Actions), que usa el Admin SDK con service
// account y por diseño IGNORA estas reglas. Por eso desde el cliente NO se
// permite ninguna escritura; solo lectura pública de precios e historial.
service cloud.firestore {
  match /databases/{database}/documents {

    // Precios vigentes (config/prices) — leídos por toda la web.
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Historial de precios — mostrado en el gráfico del menú.
    match /priceHistory/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
